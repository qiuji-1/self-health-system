{"remainingRequest":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!A:\\2026Project\\self-health-system\\source code\\view\\src\\views\\user\\CollectionRecipe.vue?vue&type=style&index=0&id=6bee43f4&scoped=true&lang=scss&","dependencies":[{"path":"A:\\2026Project\\self-health-system\\source code\\view\\src\\views\\user\\CollectionRecipe.vue","mtime":1754293978000},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\css-loader\\dist\\cjs.js","mtime":1768477206720},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1768477211883},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\postcss-loader\\src\\index.js","mtime":1768477208490},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\sass-loader\\dist\\cjs.js","mtime":1768477204924},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1768477204961},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\vue-loader\\lib\\index.js","mtime":1768477209863}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["CollectionRecipe.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAsJA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"CollectionRecipe.vue","sourceRoot":"src/views/user","sourcesContent":["<template>\r\n    <div class=\"container\">\r\n        <div class=\"top-header\">\r\n            <div class=\"nav-left\">\r\n                <i class=\"el-icon-shopping-cart-full\"></i>\r\n                收藏食谱\r\n            </div>\r\n            <div class=\"nav-right\">\r\n                <div>\r\n                    <AutoInput placeholder=\"搜索食谱\" @listener=\"listener\" />\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <!-- 表格及分页信息 -->\r\n        <div>\r\n            <el-table :data=\"apiResult.data\">\r\n                <el-table-column prop=\"name\" label=\"标题\"></el-table-column>\r\n                <el-table-column prop=\"createTime\" :sortable=\"true\" width=\"168\" label=\"发布时间\"></el-table-column>\r\n                <el-table-column label=\"\" width=\"150\" align=\"center\">\r\n                    <template #default=\"scope\">\r\n                        <div class=\"operate-buttons\">\r\n                            <el-dropdown trigger=\"click\" placement=\"bottom-end\">\r\n                                <span class=\"el-dropdown-link\">\r\n                                    <i class=\"el-icon-more\"></i>\r\n                                </span>\r\n                                <el-dropdown-menu slot=\"dropdown\">\r\n                                    <el-dropdown-item @click.native=\"view(scope.row)\"\r\n                                        icon=\"el-icon-turn-off\">前去阅读</el-dropdown-item>\r\n                                    <el-dropdown-item @click.native=\"handleDelete(scope.row)\"\r\n                                        icon=\"el-icon-star-off\">取消收藏</el-dropdown-item>\r\n                                </el-dropdown-menu>\r\n                            </el-dropdown>\r\n                        </div>\r\n                    </template>\r\n                </el-table-column>\r\n            </el-table>\r\n            <!-- 分页组件区域 -->\r\n            <div class=\"pager\">\r\n                <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\r\n                    :current-page=\"recipeQueryDto.current\" :page-sizes=\"[10, 20]\"\r\n                    :page-size=\"recipeQueryDto.size\" layout=\"total, sizes, prev, pager, next, jumper\"\r\n                    :total=\"apiResult.total\"></el-pagination>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- 删除确认弹窗 -->\r\n        <el-dialog title=\"取消收藏\" :show-close=\"false\" :visible.sync=\"dialogDeletedVisible\" width=\"20%\">\r\n            <span>确定取消收藏【{{ recipe.name }}】？</span>\r\n            <span slot=\"footer\" class=\"dialog-footer\">\r\n                <el-button size=\"mini\" @click=\"dialogDeletedVisible = false\">取消</el-button>\r\n                <el-button size=\"mini\" type=\"primary\" @click=\"collectionOperation\">确定</el-button>\r\n            </span>\r\n        </el-dialog>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\n// B站【程序员辰星】原创出品\r\nimport AutoInput from \"@/components/AutoInput.vue\";\r\nimport Editor from \"@/components/Editor\"\r\n\r\nexport default {\r\n    components: { AutoInput, Editor },\r\n    data() {\r\n        return {\r\n            fileUploadApi: '/api/v1.0/self-health-api/file/upload',\r\n            direction: 'rtl',\r\n            recipe: {},\r\n            dialogControlOperation: true,\r\n            id: null,\r\n            apiResult: {\r\n                data: [],\r\n                total: 0,\r\n            },\r\n            recipeQueryDto: {\r\n                current: 1,\r\n                size: 10,\r\n            },\r\n            dialogDeletedVisible: false,\r\n            flowIndexType: {\r\n                TYPE_1: 2, // 浏览\r\n                TYPE_2: 3, // 点赞\r\n                TYPE_3: 4, // 收藏\r\n                TYPE_4: 5, // 停留\r\n            },\r\n        };\r\n    },\r\n    created() {\r\n        this.fetchFreshData();\r\n    },\r\n    methods: {\r\n        async collectionOperation() { // 收藏操作\r\n            try {\r\n\r\n                await this.$axios.post('/flow-index/operation', {\r\n                    type: this.flowIndexType.TYPE_3,\r\n                    contentModule: \"RECIPE\",\r\n                    contentId: this.recipe.id\r\n                });\r\n\r\n                this.dialogDeletedVisible = false; // 关闭取消收藏弹窗\r\n                this.fetchFreshData();\r\n                this.$message.success('取消收藏成功');\r\n\r\n            } catch (error) {\r\n                console.error('取消收藏失败:', error);\r\n            }\r\n        },\r\n        view(news) {\r\n            window.open(`/recipe-detail?id=${news.id}`);\r\n        },\r\n        onListener(content) {\r\n            this.recipe.content = content;\r\n        },\r\n        handleClose() {\r\n            this.dialogControlOperation = true;\r\n            this.recipe = {};\r\n        },\r\n        listener(text) {\r\n            this.recipeQueryDto.title = text;\r\n            this.fetchFreshData();\r\n        },\r\n        async fetchFreshData() {\r\n            try {\r\n                const { data, total } = await this.$axios.post('/recipe/collectionList', this.recipeQueryDto);\r\n                this.apiResult.data = data;\r\n                this.apiResult.total = total;\r\n            } catch (error) {\r\n                console.error('查询食谱信息异常:', error);\r\n            }\r\n        },\r\n        handleSizeChange(size) {\r\n            this.recipeQueryDto.size = size;\r\n            this.recipeQueryDto.current = 1;\r\n            this.fetchFreshData();\r\n        },\r\n        handleCurrentChange(current) {\r\n            this.recipeQueryDto.current = current;\r\n            this.fetchFreshData();\r\n        },\r\n        handleDelete(row) {\r\n            this.recipe = { ...row };\r\n            this.dialogDeletedVisible = true;\r\n            this.id = row.id;\r\n        },\r\n    },\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.pager {\r\n    margin-block: 20px;\r\n}\r\n\r\n.operate-buttons {\r\n    opacity: 0;\r\n    transition: opacity 0.3s;\r\n    cursor: pointer;\r\n\r\n    i {\r\n        padding: 8px;\r\n        border-radius: 6px;\r\n        transition: all .5s ease;\r\n\r\n        &:hover {\r\n            background-color: rgb(236, 237, 238);\r\n        }\r\n    }\r\n}\r\n\r\n.el-table__body tr:hover .operate-buttons {\r\n    opacity: 1;\r\n}\r\n\r\n.container {\r\n    margin: 10px 20px;\r\n}\r\n\r\n.top-header {\r\n    margin-block: 10px;\r\n    padding-inline: 10px;\r\n    border-radius: 5px;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n\r\n    .nav-left,\r\n    .nav-right {\r\n        display: flex;\r\n        justify-content: left;\r\n        align-items: center;\r\n        gap: 10px;\r\n    }\r\n}\r\n</style>"]}]}