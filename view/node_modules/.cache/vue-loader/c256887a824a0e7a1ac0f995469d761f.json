{"remainingRequest":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!A:\\2026Project\\self-health-system\\source code\\view\\src\\views\\user\\MyDiet.vue?vue&type=style&index=0&id=3a665c7a&scoped=true&lang=scss&","dependencies":[{"path":"A:\\2026Project\\self-health-system\\source code\\view\\src\\views\\user\\MyDiet.vue","mtime":1774602616998},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\css-loader\\dist\\cjs.js","mtime":1768477206720},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1768477211883},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\postcss-loader\\src\\index.js","mtime":1768477208490},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\sass-loader\\dist\\cjs.js","mtime":1768477204924},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1768477204961},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\vue-loader\\lib\\index.js","mtime":1768477209863}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["MyDiet.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAsHA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;;AAEA","file":"MyDiet.vue","sourceRoot":"src/views/user","sourcesContent":["<template>\n    <div class=\"detail-container\">\n        <div class=\"content\">\n            <div class=\"page-header\">\n                <el-page-header @back=\"goBack\" content=\"记录饮食\">\n                </el-page-header>\n            </div>\n            <div style=\"box-shadow: 0 4px 8px rgb(240,240,240);padding: 20px 10px;\">\n                <UserRecipe @selected=\"recipeSelected\" />\n                <UserDietHistory :notifyFlag=\"notifyFlag\"/>\n            </div>\n        </div>\n        <div class=\"evaluations\">\n            <div class=\"nav-text\">\n                <div class=\"left\">\n                    记录饮食\n                </div>\n                <div class=\"right\" @click=\"recipeList = []\">\n                    <el-tooltip class=\"item\" effect=\"dark\" content=\"清空选中项\" placement=\"bottom\">\n                        <i class=\"el-icon-s-open\"></i>\n                    </el-tooltip>\n                </div>\n            </div>\n            <div class=\"input-area\">\n                <div v-if=\"!recipeList.length\">\n                    <el-empty description=\"请选中食谱\"></el-empty>\n                </div>\n                <div class=\"item-model\" v-for=\"(recipe, index) in recipeList\" :key=\"index\">\n                    <div class=\"name\">\n                        {{ recipe.name }}\n                    </div>\n                    <div class=\"input\">\n                        <el-input v-model=\"recipe.value\" placeholder=\"输入食用量（单位g）\"></el-input>\n                    </div>\n                </div>\n                <div class=\"item-model\" v-if=\"recipeList.length\">\n                    <div class=\"name\">\n                        饮食备注\n                    </div>\n                    <div class=\"input\">\n                        <el-input type=\"textarea\" :rows=\"2\" placeholder=\"饮食备注\" v-model=\"detail\">\n                        </el-input>\n                    </div>\n                </div>\n\n                <div v-if=\"recipeList.length\">\n                    <div style=\"text-align: center;margin-right: 0;margin-left: 0;padding-block: 10px;\"\n                        class=\"primary-bt\" @click=\"saveDiet\">\n                        <i class=\"el-icon-success\"></i>\n                        立即新增\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</template>\n\n<script>\nimport UserRecipe from '@/views/user/UserRecipe';\nimport UserDietHistory from '@/views/user/UserDietHistory';\nexport default {\n    components: { UserRecipe, UserDietHistory },\n    name: \"HealthRecord\",\n    data() {\n        return {\n            recipeList: [], // 选中的模组项\n            detail: '',\n            notifyFlag: false,\n        }\n    },\n    async created() {\n\n    },\n    methods: {\n        async saveDiet() {\n            try {\n                const recipeList = this.recipeList.map(recipe => {\n                    return {\n                        recipeId: recipe.id,\n                        detail: this.detail,\n                        value: recipe.value\n                    }\n                });\n                const { message } = await this.$axios.post(`/diet-history/save`, recipeList);\n                this.$notify.success({\n                    title: '饮食记录',\n                    message: message,\n                    duration: 1000,\n                    position: 'bottom-right'\n                });\n                this.recipeList = [];\n                // 通知用户饮食组件，及时更新数据\n                this.notifyFlag = true;\n            } catch (error) {\n                this.$message.error(error.message);\n                console.error('饮食记录异常:', error);\n            }\n        },\n        recipeSelected(recipe) {\n            if (!this.recipeList.includes(recipe)) {\n                this.recipeList.push(recipe);\n            } else {\n                this.$notify.info({\n                    title: '提示',\n                    message: '当前食谱已存在',\n                    duration: 1000,\n                    position: 'bottom-right'\n                })\n            }\n        },\n        goBack() {\n            this.$router.push('/user');\n        },\n    }\n}\n</script>\n\n<style scoped lang=\"scss\">\n.detail-container {\n    display: flex;\n    min-height: 100vh;\n    padding: 10px 20px;\n    box-sizing: border-box;\n    gap: 20px;\n\n    .content {\n        width: 60%;\n\n        .page-header {\n            padding: 20px 30px;\n        }\n    }\n\n    .evaluations {\n        width: 40%;\n        padding: 20px 30px;\n\n        .nav-text {\n            display: flex;\n            justify-content: space-between;\n            font-size: 18px;\n\n            .right {\n                padding: 4px;\n                box-sizing: border-box;\n                background-color: rgb(245, 245, 245);\n                cursor: pointer;\n                border-radius: 2px;\n\n                &:hover {\n                    background-color: rgb(240, 240, 240);\n                }\n            }\n        }\n\n        .input-area {\n            margin-block: 40px;\n\n            .item-model {\n                margin-bottom: 20px;\n\n                .name {\n                    font-size: 18px;\n                }\n\n                .input {\n                    margin-block: 10px;\n                }\n            }\n        }\n\n    }\n\n}\n</style>"]}]}