{"remainingRequest":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!A:\\2026Project\\self-health-system\\source code\\view\\src\\views\\user\\RecipeDetail.vue?vue&type=style&index=0&id=44356339&scoped=true&lang=scss&","dependencies":[{"path":"A:\\2026Project\\self-health-system\\source code\\view\\src\\views\\user\\RecipeDetail.vue","mtime":1754383020000},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\css-loader\\dist\\cjs.js","mtime":1768477206720},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\vue-loader\\lib\\loaders\\stylePostLoader.js","mtime":1768477211883},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\postcss-loader\\src\\index.js","mtime":1768477208490},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\sass-loader\\dist\\cjs.js","mtime":1768477204924},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1768477204961},{"path":"A:\\2026Project\\self-health-system\\source code\\view\\node_modules\\vue-loader\\lib\\index.js","mtime":1768477209863}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["RecipeDetail.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAgGA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA","file":"RecipeDetail.vue","sourceRoot":"src/views/user","sourcesContent":["<template>\n    <div class=\"detail-container\">\n        <div class=\"content\">\n            <div class=\"title\">\n                <div>\n                    <el-page-header @back=\"goBack\" content=\"食谱详情\">\n                    </el-page-header>\n                </div>\n                <div style=\"margin-top: 20px;\">\n                    {{ recipe.name }}\n                </div>\n                <div class=\"user-info\">\n                    <img :src=\"recipe.avatar\" alt=\"\">\n                    <div>{{ recipe.username }}</div>\n                    <div>发布于{{ recipe.createTime }}</div>\n                </div>\n\n            </div>\n            <div class=\"content\" v-html=\"recipe.content\"></div>\n            <div>\n                <FlowIndex :contentId=\"Number(id)\" contentModule=\"RECIPE\" />\n            </div>\n            <div>\n                <Evaluations :userId=\"userId\" :avatar=\"avatar\" contentType=\"HEALTH-NEWS\" :contentId=\"Number(id)\" />\n            </div>\n        </div>\n        <div class=\"right\">\n            <h3 style=\"margin-top: 0;margin-left: 8px;\">推荐食谱</h3>\n            <div @click=\"recipeClick(recipe)\" class=\"item\" v-for=\"(recipe, index) in recipeRecommendList\" :key=\"index\">\n                <img class=\"cover\" :src=\"recipe.cover\" alt=\"\" srcset=\"\"></img>\n                <div class=\"title\">{{ recipe.name }}</div>\n            </div>\n        </div>\n    </div>\n</template>\n\n<script>\nimport Evaluations from \"@/components/Evaluations\"\nimport FlowIndex from \"@/components/FlowIndex\"\nexport default {\n    components: { Evaluations, FlowIndex },\n    name: \"recipeDetail\",\n    data() {\n        return {\n            id: null,\n            recipe: {},\n            userId: 0,\n            avatar: '',\n            recommendCount: 3,\n            recipeRecommendList: []\n        }\n    },\n    async created() {\n        await this.fetchUserBaseInfo();\n        this.id = this.$router.currentRoute.query.id;\n        this.fetchRecipeDetail(this.id);\n        this.fetchRecommendRecipe(this.recommendCount);\n    },\n    methods: {\n        recipeClick(recipe){\n            this.id = recipe.id;\n            this.fetchRecipeDetail(recipe.id);\n        },\n        goBack() {\n            this.$router.push('/user');\n        },\n        async fetchRecommendRecipe(count) {\n            try {\n                const { data } = await this.$axios.get(`/recipe/recommend/${count}`);\n                this.recipeRecommendList = data;\n            } catch (error) {\n                this.$message.info(error.message);\n            }\n        },\n        async fetchUserBaseInfo() {\n            try {\n                const { data } = await this.$axios.get(`/user/auth`);\n                this.userId = data.id;\n                this.avatar = data.avatar;\n            } catch (error) {\n                console.error('查询用户信息信息异常:', error);\n            }\n        },\n        async fetchRecipeDetail(id) {\n            try {\n                const { data } = await this.$axios.get(`/recipe/${id}`);\n                this.recipe = data;\n            } catch (error) {\n                console.error('查询食谱详情信息异常:', error);\n            }\n        },\n    }\n}\n</script>\n\n<style scoped lang=\"scss\">\n.right {\n    width: 15%;\n    box-sizing: border-box;\n    // box-shadow: 0 4px 6px rgb(240, 240, 240);\n    padding: 20px;\n\n    .item {\n        margin-bottom: 10px;\n        cursor: pointer;\n        padding: 10px;\n\n        &:hover {\n            transform: translateY(-2px);\n        }\n\n        .cover {\n            width: 200px;\n            height: 110px;\n            border-radius: 5px;\n        }\n    }\n}\n\n.detail-container {\n    display: flex;\n    min-height: 100vh;\n    padding: 20px 100px;\n    box-sizing: border-box;\n    gap: 40px;\n\n    .content {\n        width:85%;\n\n        .title {\n            font-size: 26px;\n            font-weight: 600;\n            position: sticky;\n            top: 0;\n\n            z-index: 100;\n            background-color: rgb(255, 255, 255);\n\n            .user-info {\n                display: flex;\n                margin-bottom: 10px;\n                font-weight: 400;\n                justify-content: left;\n                align-items: center;\n                gap: 6px;\n                padding-block: 15px;\n\n                img {\n                    width: 20px;\n                    height: 20px;\n                    border-radius: 50%;\n                }\n\n                div {\n                    font-size: 14px;\n                    color: #666;\n                }\n            }\n        }\n\n        .time {\n            font-size: 16px;\n            margin-bottom: 10px;\n        }\n\n        .summary {\n            background-color: rgb(246, 246, 246);\n            padding: 20px;\n            box-sizing: border-box;\n            font-size: 14px;\n            border-radius: 5px;\n        }\n\n        .content {\n            width: 100%;\n        }\n    }\n\n    .right {\n        width: 40%;\n    }\n}\n</style>"]}]}